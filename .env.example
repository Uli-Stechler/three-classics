# Copy to .env to override. Every value has a working default, so .env is optional.
POSTGRES_DB=threeclassics
POSTGRES_USER=threeclassics
POSTGRES_PASSWORD=threeclassics
# Host port for the app (http://localhost:8080).
APP_PORT=8080
# "dev" exposes POST /api/dev/games, which the end-to-end tests need.
SPRING_PROFILES_ACTIVE=default
